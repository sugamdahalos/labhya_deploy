# Labhya GPU Agent Configuration
# Copy this file to .env and update with your settings

# Backend server URL
LABHYA_API_URL=http://localhost:8000

# Agent credentials (get these from your backend admin)
LABHYA_AGENT_EMAIL=agent@example.com
LABHYA_AGENT_PASSWORD=your-secure-password

# SSH tunnel configuration (for production)
TUNNEL_SERVER_HOST=your-server.com
TUNNEL_USER=tunnel-user

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
