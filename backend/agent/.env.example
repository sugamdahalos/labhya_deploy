# Labhya GPU Agent Configuration
# Update these settings for your environment

# Backend server URL
LABHYA_API_URL=http://localhost:8000

# Agent credentials - IMPORTANT: You need to create a host account first!
# 1. Go to http://localhost:3001/register (or your frontend URL)
# 2. Create a host account 
# 3. Use those credentials here
LABHYA_AGENT_EMAIL=
LABHYA_AGENT_PASSWORD=

# SSH tunnel configuration (for production)
TUNNEL_SERVER_HOST=your-server.com
TUNNEL_USER=tunnel-user

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
